#!/usr/bin/env bash
# notify-pane — send a tagged message (or file) to a peer CLI agent running
# in a tmux pane, locally or on a mesh peer host. Address book at
# ~/.agents/registry.toml (auto-maintained by agent-register-hook).
#
# Usage:
#   notify-pane <agent> "<message body>"
#   notify-pane <agent> --file <path> ["<optional body>"]
#   notify-pane --list
#   notify-pane --whoami
#
# --file <path>: scp the file to the recipient host at
#   ~/.agent-inbox/<sender>/<basename>, then deliver a one-line notification
#   "file dropped at <path> (N bytes)". The recipient agent reads the file
#   from its own filesystem.
#
# Env:
#   AGENT_NAME      sender identity (e.g. "<host>-<session>-<window>"); auto-
#                   detected from hostname + current tmux session if unset.
#   FORCE_SEND=1    skip the mid-prompt safety check on the recipient.
#   SKIP_DISMISS=1  skip the auto-Escape on detected modal dialogs (the
#                   recipient stays in the dialog and the message lands in
#                   whatever input field the dialog exposes).
#
# Exit codes:
#   0  delivered
#   1  usage / missing args / unreadable --file
#   2  agent not in ~/.agents/registry.toml
#   3  recipient looks mid-prompt; refused (set FORCE_SEND=1 to override)
#   4  ssh/tmux failure on the wire
set -euo pipefail

REGISTRY="${HOME}/.agents/registry.toml"
TMUX_BIN="${TMUX_BIN:-tmux}"
TMUX_SOCKET="${TMUX_SOCKET:-/tmp/tmux-$(id -u)/default}"

usage() {
  sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' >&2
  exit 1
}

lookup() {
  local name="$1" field="$2"
  awk -v want="$name" -v field="$field" '
    /^\[agents\./ {
      h = $0; gsub(/[][]/, "", h); split(h, a, ".")
      in_block = (a[1] == "agents" && a[2] == want)
      next
    }
    /^\[/ { in_block = 0 }
    in_block && $0 ~ "^[[:space:]]*" field "[[:space:]]*=" {
      sub(/^[^=]*=[[:space:]]*/, "")
      gsub(/^"|"$/, "")
      print
      exit
    }
  ' "$REGISTRY"
}

slug() {
  echo "$1" | tr '[:upper:]' '[:lower:]' \
            | sed 's/[^a-z0-9]\+/-/g; s/^-//; s/-$//' \
            | head -c 40
}

agent_exists() {
  local name="$1"
  awk -v want="$name" '
    /^\[agents\./ {
      h = $0; gsub(/[][]/, "", h); split(h, a, ".")
      if (a[1] == "agents" && a[2] == want) found = 1
    }
    END { if (found) exit 0; exit 1 }
  ' "$REGISTRY"
}

resolve_agent() {
  local name="$1" name_slug
  [ -r "$REGISTRY" ] || return 1
  if agent_exists "$name"; then
    printf '%s\n' "$name"
    return 0
  fi

  name_slug=$(slug "$name")
  awk -v want="$name" -v want_slug="$name_slug" '
    function make_slug(s) {
      s = tolower(s)
      gsub(/[^a-z0-9]+/, "-", s)
      sub(/^-/, "", s)
      sub(/-$/, "", s)
      return substr(s, 1, 40)
    }
    /^\[agents\./ {
      h = $0; gsub(/[][]/, "", h); split(h, a, ".")
      agent = a[2]
      in_block = (a[1] == "agents")
      next
    }
    /^\[/ { in_block = 0 }
    in_block && /^[[:space:]]*window[[:space:]]*=/ {
      value = $0
      sub(/^[^=]*=[[:space:]]*/, "", value)
      gsub(/^"|"$/, "", value)
      if (value == want || make_slug(value) == want_slug) print agent
    }
  ' "$REGISTRY" | sort -u
}

list_agents() {
  [ -r "$REGISTRY" ] || return 0
  sed -n 's/^\[agents\.\([^]]\+\)\].*/\1/p' "$REGISTRY"
}

self_alias() {
  if [ -r "${HOME}/.agents/self.conf" ]; then
    head -1 "${HOME}/.agents/self.conf" | sed 's/[[:space:]]//g'
  else
    hostname -s
  fi
}

sender_id() {
  if [ -n "${AGENT_NAME:-}" ]; then echo "$AGENT_NAME"; return; fi
  local h s
  h=$(self_alias)
  if s=$("$TMUX_BIN" -S "$TMUX_SOCKET" display-message -p '#S' 2>/dev/null); then
    echo "${h}[${s}]"
  else
    echo "$h"
  fi
}

safe_component() {
  printf '%s' "$1" | tr '[:space:]' '_' \
    | sed 's/[^A-Za-z0-9._-]/_/g; s/__*/_/g; s/^_*//; s/_*$//'
}

is_self() {
  [ "$1" = "$(self_alias)" ]
}

run_tmux() {
  local host="$1"; shift
  if is_self "$host"; then
    "$TMUX_BIN" -S "$TMUX_SOCKET" "$@"
  else
    local cmd="$TMUX_BIN -S $TMUX_SOCKET"
    local a
    for a in "$@"; do cmd+=" $(printf '%q' "$a")"; done
    ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" "$cmd"
  fi
}

case "${1:-}" in
  --list)   list_agents; exit 0 ;;
  --whoami) sender_id; exit 0 ;;
  -h|--help) usage ;;
  '')       usage ;;
esac

agent="${1:-}"; shift || true
file=""
case "${1:-}" in
  -f|--file) file="${2:-}"; shift 2 ;;
esac
body="$*"

if [ -z "$agent" ] || { [ -z "$body" ] && [ -z "$file" ]; }; then
  usage
fi

matches=()
mapfile -t matches < <(resolve_agent "$agent" || true)
case "${#matches[@]}" in
  0)
    echo "notify-pane: unknown agent or unique window '$agent' - try --list" >&2
    exit 2
    ;;
  1)
    if [ "${matches[0]}" != "$agent" ]; then
      echo "notify-pane: resolved '$agent' to '${matches[0]}'" >&2
      agent="${matches[0]}"
    fi
    ;;
  *)
    echo "notify-pane: window name '$agent' is ambiguous; use one of:" >&2
    printf '  %s\n' "${matches[@]}" >&2
    exit 2
    ;;
esac

host=$(lookup "$agent" "host")
target=$(lookup "$agent" "target")
if [ -z "$host" ] || [ -z "$target" ]; then
  echo "notify-pane: unknown agent '$agent' — try --list" >&2
  exit 2
fi

if [ -n "$file" ]; then
  [ -r "$file" ] || { echo "notify-pane: cannot read $file" >&2; exit 1; }
  sender=$(safe_component "$(sender_id)")
  [ -n "$sender" ] || sender="unknown"
  basename=$(safe_component "$(basename -- "$file")")
  [ -n "$basename" ] || basename="file"
  # shellcheck disable=SC2088
  remote_path_display="~/.agent-inbox/${sender}/${basename}"
  if is_self "$host"; then
    mkdir -p "$HOME/.agent-inbox/${sender}"
    chmod 700 "$HOME/.agent-inbox" "$HOME/.agent-inbox/${sender}" 2>/dev/null || true
    cp -f "$file" "$HOME/.agent-inbox/${sender}/${basename}"
    chmod 600 "$HOME/.agent-inbox/${sender}/${basename}" 2>/dev/null || true
  else
    ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" "mkdir -p ~/.agent-inbox/${sender} && chmod 700 ~/.agent-inbox ~/.agent-inbox/${sender}"
    scp -q -o BatchMode=yes -o ConnectTimeout=5 "$file" "$host:.agent-inbox/${sender}/${basename}"
    ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" "chmod 600 ~/.agent-inbox/${sender}/${basename}" || true
  fi
  drop_note="file dropped at ${remote_path_display} ($(wc -c < "$file") bytes)"
  if [ -n "$body" ]; then body="${drop_note}: ${body}"; else body="${drop_note}"; fi
fi

tag="[from $(sender_id) @ $(date -u +%Y-%m-%dT%H:%M:%SZ)]"

# Capture once and reuse for both the mid-prompt safety check and modal
# dismissal. -J joins wrapped lines so dialog tab strips render contiguously.
pane=$(run_tmux "$host" capture-pane -p -J -t "$target" 2>/dev/null | tail -30 || true)

if [ "${FORCE_SEND:-}" != "1" ]; then
  if echo "$pane" | tail -3 | grep -qE '[❯>][[:space:]]*[^[:space:]]'; then
    echo "notify-pane: recipient '$agent' looks mid-prompt; refusing. Last lines:" >&2
    echo "$pane" | tail -3 >&2
    echo "(re-run with FORCE_SEND=1 to override)" >&2
    exit 3
  fi
fi

# Dismiss known Claude Code modals (e.g. /config, /help) by sending Escape
# before the actual delivery. Without this, a recipient stuck in the /config
# dialog after a fleet-wide /config reload eats the notification into its
# search box. See https://github.com/danimoya/agent-mesh/issues/2
#
# Markers we recognize, narrowly scoped to avoid Escape during tool execution
# (where it would surface an interrupt-confirmation prompt):
#   /config  → "Status … Config … Usage … Stats" tab strip
#   /help    → "Help" header + a "/commands" list line
#   /permissions → "Permissions" header + "Allow" / "Deny" / "Ask" markers
# Opt out with SKIP_DISMISS=1.
modal_detected=""
if [ "${SKIP_DISMISS:-}" != "1" ]; then
  if echo "$pane" | grep -qE 'Status[[:space:]]+Config[[:space:]]+Usage[[:space:]]+Stats'; then
    modal_detected="/config"
  elif echo "$pane" | grep -qE '^[[:space:]]*Help[[:space:]]*$' && \
       echo "$pane" | grep -qE '/[a-z][-a-z]+[[:space:]]'; then
    modal_detected="/help"
  elif echo "$pane" | grep -qE '^[[:space:]]*Permissions[[:space:]]*$' && \
       echo "$pane" | grep -qE '(Allow|Deny|Ask)[[:space:]]'; then
    modal_detected="/permissions"
  fi
fi
if [ -n "$modal_detected" ]; then
  echo "notify-pane: dismissing $modal_detected modal on '$agent' before delivery" >&2
  run_tmux "$host" send-keys -t "$target" Escape
  sleep 0.5
fi

if ! run_tmux "$host" send-keys -t "$target" -l "$tag $body"; then
  echo "notify-pane: send-keys failed for '$agent' (${host}[${target}])" >&2
  exit 4
fi
if ! run_tmux "$host" send-keys -t "$target" Enter; then
  echo "notify-pane: send-keys Enter failed for '$agent' (${host}[${target}])" >&2
  exit 4
fi

echo "→ $agent (${host}[${target}]): $body"
